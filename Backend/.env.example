# ==============================================================================
# NEP Haryana Excellence Awards 2026 - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL / Neon Cloud)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.aws.neon.tech/neondb?sslmode=require

# Frontend Base URL (used for email verification links & CORS)
FRONTEND_URL=http://localhost:5173

# Email Dispatch Configuration
# For production or sending actual emails over SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# For local development printing to terminal console:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Haryana Govt <noreply@haryana.gov.in>

# Legacy direct upload to Cloudinary: leave unset unless HSHEC approves third-party storage of evidence
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET_NAME=
MAX_EVIDENCE_FILE_SIZE=5242880

# Security Keys (Required for Production)
# DJANGO_SECRET_KEY=your-production-django-secret-key
# JWT_SIGNING_KEY=your-production-jwt-signing-key
